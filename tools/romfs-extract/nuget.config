<?xml version="1.0" encoding="utf-8"?>
<!-- Sources des paquets : nuget.org, et le flux officiel du projet Ryujinx pour Ryujinx.LibHac seulement. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Ryujinx" value="https://git.ryujinx.app/api/packages/projects/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Ryujinx">
      <package pattern="Ryujinx.LibHac" />
    </packageSource>
  </packageSourceMapping>
</configuration>
