diff --git a/plugin/overlay/source/program/game.cpp b/plugin/overlay/source/program/game.cpp
index be75cd9..3f4573c 100644
--- a/plugin/overlay/source/program/game.cpp
+++ b/plugin/overlay/source/program/game.cpp
@@ -851,6 +851,42 @@ namespace coop::game {
         return 0;
     }
 
+    /*
+     * NOTES 6.21 : emet une cle ELink sur un acteur, comme le systeme chimique du jeu. Desassemblage de main 1.9.0 :
+     * main+0x1587e50 prend la cle dans la table main+0x1d652e0 ("Chemical_Fire", ..., "Chemical_Explosion" a
+     * l'index 6), lit l'instance ELink a XLink+0x48 (XLink de l'acteur a acteur+0x568, Actor::mXLink dans la decomp
+     * actActor.h ; ignoree si l'octet XLink+0xcd a le bit 2) et appelle main+0xf3fc20(instance, cle, &poignee).
+     * main+0xf3fc10 / +0xf3fc20 / +0xf3fc24 sont trois sauts de 16, 4 et 4 octets, comme en 1.5.0 (decomp,
+     * uking_functions.csv) xlink2::UserInstanceELink::searchAndEmit(const char*), searchAndEmit(const char*,
+     * HandleELink*) et emit(const Locator&, HandleELink*). Poignee : {evenement, numero}, mise a zero avant. La
+     * sphere d'une bombe est la cle "Chemical_Explosion" de l'utilisateur ELink "Bomb" (ELink2DB de Bootup.pack,
+     * lu avec le format de Nitr4m12/xlink2). Fil du jeu. Retour : 0 emis, <0 refus.
+     */
+    int EmitActorELink(std::uintptr_t actor, const char* key) {
+        constexpr std::size_t Actor_XLink = 0x568, XLink_ELinkInstance = 0x48, XLink_Flags = 0xcd;
+        constexpr std::uintptr_t SearchAndEmitWithHandle = 0xf3fc20;
+        if (actor == 0 || key == nullptr || !CanReadMemory(actor + Actor_XLink, 8))
+            return -1;
+        const auto xlink = Peek<std::uintptr_t>(actor + Actor_XLink);
+        if (!LooksLikeHeapPtr(xlink) || !CanReadMemory(xlink, 0xd0))
+            return -2;
+        if ((Peek<std::uint8_t>(xlink + XLink_Flags) & 4) != 0)
+            return -3; /* le jeu n'emet pas non plus dans ce cas */
+        const auto instance = Peek<std::uintptr_t>(xlink + XLink_ELinkInstance);
+        if (!LooksLikeHeapPtr(instance))
+            return -4;
+        struct Handle {
+            std::uintptr_t m_Event;
+            std::uint32_t m_Id;
+            std::uint32_t m_Pad;
+        } handle { 0, 0, 0 };
+        /* Valeur de retour non utilisee (type non confirme en 1.9.0) : la poignee remplie dit si l'evenement existe,
+           comme le controle du systeme chimique (main+0x1587f0c). */
+        using EmitFn = void (*)(std::uintptr_t instance, const char* key, Handle* handle);
+        reinterpret_cast<EmitFn>(MainBase() + SearchAndEmitWithHandle)(instance, key, &handle);
+        return handle.m_Event != 0 ? 0 : -5;
+    }
+
     namespace {
         bool Near(float a, float b) { const float d = a - b; return d > -0.05f && d < 0.05f; }
 
