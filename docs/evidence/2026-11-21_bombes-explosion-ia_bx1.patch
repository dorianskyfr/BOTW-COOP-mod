diff --git a/plugin/overlay/source/program/game.cpp b/plugin/overlay/source/program/game.cpp
index dbe9f3f..ffab2df 100644
--- a/plugin/overlay/source/program/game.cpp
+++ b/plugin/overlay/source/program/game.cpp
@@ -793,6 +793,53 @@ namespace coop::game {
         return 0;
     }
 
+    /*
+     * Demande a l'IA d'un acteur de passer sur un de ses enfants (NOTES 6.03).
+     * Decomp botw (src/KingSystem/ActorSystem) : Actor::mRootAi a +0x558 (actActor.h ; notre ASList releve a +0x560
+     * le suit) ; ActionBase (actAiActionBase.h), apres les 2 virtuelles de SEAD_RTTI_BASE et les 2 du destructeur :
+     * changeChildLater(const SafeString&) indice 22, getCurrentChild() indice 26. Ai::changeChildLater (actAiAi.cpp)
+     * cherche le nom parmi les enfants directs et le met en attente ; le changement se fait au calc suivant.
+     * On l'appelle sur l'enfant courant de l'IA racine (pour une bombe : l'IA « Root », classe RemoteBomb).
+     * Retour : 0 fait ; <0 refus (pointeurs ou tables hors du module main, enfant inconnu).
+     */
+    int RequestAiChildChange(std::uintptr_t actor, const char* child) {
+        constexpr std::size_t Actor_RootAi = 0x558;
+        constexpr int Slot_ChangeChildLater = 22, Slot_GetCurrentChild = 26;
+        if (s_Offsets == nullptr || actor == 0 || child == nullptr)
+            return -1;
+        const auto& info = exl::util::GetMainModuleInfo();
+        const auto inMain = [&](std::uintptr_t p) { return p >= info.m_Total.m_Start && p < info.m_Total.m_Start + info.m_Total.m_Size; };
+        const auto inText = [&](std::uintptr_t p) { return p >= info.m_Text.m_Start && p < info.m_Text.m_Start + info.m_Text.m_Size; };
+        const auto root = Peek<std::uintptr_t>(actor + Actor_RootAi);
+        if (!LooksLikeHeapPtr(root))
+            return -2;
+        const auto rootVt = Peek<std::uintptr_t>(root);
+        if (!inMain(rootVt))
+            return -3;
+        const auto getChild = Peek<std::uintptr_t>(rootVt + Slot_GetCurrentChild * sizeof(std::uintptr_t));
+        if (!inText(getChild))
+            return -4;
+        const auto ai = reinterpret_cast<std::uintptr_t (*)(std::uintptr_t)>(getChild)(root);
+        if (!LooksLikeHeapPtr(ai))
+            return -5;
+        const auto aiVt = Peek<std::uintptr_t>(ai);
+        if (!inMain(aiVt))
+            return -6;
+        const auto changeLater = Peek<std::uintptr_t>(aiVt + Slot_ChangeChildLater * sizeof(std::uintptr_t));
+        if (!inText(changeLater))
+            return -7;
+        const auto vtSlot = Peek<std::uintptr_t>(MainBase() + 0x1d66260); /* SafeString, comme ChangeStage */
+        if (vtSlot == 0)
+            return -8;
+        struct SafeString {
+            std::uintptr_t m_Vtable;
+            const char* m_Str;
+        };
+        const SafeString name { vtSlot + 0x10, child };
+        const auto next = reinterpret_cast<std::uintptr_t (*)(std::uintptr_t, const SafeString&)>(changeLater)(ai, name);
+        return next != 0 ? 0 : -9;
+    }
+
